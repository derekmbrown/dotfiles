{
  "mcpServers": {
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time"],
      "description": "Current time and timezone conversion"
    },
    "context-mode": {
      "command": "sh",
      "args": ["-c", "exec \"$HOME/.pi/agent/npm/node_modules/.bin/context-mode\""]
    }
  }
}
