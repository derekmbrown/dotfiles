[
  {
    "key": "shift+cmd+a",
    "command": "extension.multiCommand.execute",
    "args": {
      "sequence": [
        "workbench.scm.focus",
        "list.focusFirst",
        "list.select"
      ]
    },
    "when": "editorTextFocus"
  },
