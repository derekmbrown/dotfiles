set -g mouse on
set -g extended-keys on

set -g pane-border-lines double
set -g pane-active-border-style "fg=colour37"
set -g pane-border-style "fg=colour240"

bind -n M-Up select-pane -U
bind -n M-Down select-pane -D
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R

bind -n M-k send-keys C-l \; clear-history

set -g status-interval 1
set -g status-style "bg=colour37,fg=black"
set -g status-left-length 24
set -g status-left '#[fg=black] [#S] #h '
set -g status-right-length 21
set -g status-right '#[fg=black] %Y-%m-%d %H:%M:%S '
setw -g window-status-format ' #I:#W#{?window_flags,#F, } '
setw -g window-status-current-format '#[bg=colour51] #I:#W#{?window_flags,#F, } '
set -g window-status-separator ""