# Mouse support: click panes to focus, scroll with trackpad
set -g mouse on

# Option+arrow: move between panes without the prefix
# (iTerm2 profile: Left Option key set to "Esc+")
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
